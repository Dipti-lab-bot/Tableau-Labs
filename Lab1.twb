      <aliases enabled='yes' />
      <column caption='Review Performance score ' datatype='integer' name='[Calculation_1774940464250880]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Number Of Reviews]*[Review Scores Rating]' />
      </column>
      <column caption='Pricing categories ' datatype='string' name='[Calculation_1774940465594370]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Price]&gt;=300 then &quot;Luxury&quot; ELSEIF [Price]&gt;=150 then &quot;standard&quot; ELSE &quot;budget&quot; END' />
      </column>
      <column caption='Review category' datatype='string' name='[Calculation_1774940466233347]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF[Number Of Reviews]&gt;=100 then&quot;highly reviewed&quot; ELSE &quot;less Reviewed&quot; END' />
      </column>
      <column caption='Host Status ' datatype='string' name='[Calculation_1774940466761732]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Host Since] &lt;= TODAY() THEN &quot;Active Host&quot;&#13;&#10;ELSE &quot;New Host&quot;&#13;&#10;END' />
      </column>
      <column caption='Price  Filter Category ' datatype='string' name='[Calculation_1774940468801544]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Price]&gt;[Parameters].[Parameter 1774940467576839] then &quot;Above limit&quot; ELSE &quot;Below limit&quot; END' />
